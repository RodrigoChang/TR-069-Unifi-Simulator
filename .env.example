# Safe defaults: local monitoring only. Replace placeholders before enabling integrations.
# Example: UNIFI_INFORM_URL=http://<UNIFI_HOST>:8080/inform
UNIFI_INFORM_URL=
# Use exact Huawei SSIDs and existing 24-character WLAN _id values from your UniFi site.
# Synthetic example only: {"ExampleSSID":"0123456789abcdef01234567"}
UNIFI_WLAN_MAP={}
# Leave empty to disable writes. To opt in, use the selected CPE's real management IP.
# If more than one registered CPE shares this IP, writes stay disabled (fail-safe);
# use HUAWEI_CONTROL_DEVICE_ID instead to disambiguate.
HUAWEI_CONTROL_IP=
# Optional: pin writes to one CPE by its exact GenieACS device _id (see GenieACS UI/NBI
# `/devices`). Takes precedence over HUAWEI_CONTROL_IP when set.
HUAWEI_CONTROL_DEVICE_ID=

# Required: CWMP (TR-069) has no server-side authentication in this lab stack and is
# published on HTTP. Set this to the Docker host's trusted LAN interface address so the
# listener is never reachable from 0.0.0.0/the Internet. Example: LAN_IP=192.0.2.10
LAN_IP=127.0.0.1

# Required: GenieACS UI/NBI JWT signing secret. There is no insecure default; compose
# refuses to start without a real value here. Generate one, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
GENIEACS_UI_JWT_SECRET=
