# Estado local: contiene claves de adopción, identidad y telemetría privada.
/.state/
/.private/
/captures/
/backups/
/logs/

# Hallazgos de seguridad locales: pueden describir vulnerabilidades no corregidas.
report-data.json
hallazgos.md
hallazgos.ctb
findings/

# Configuración local del agente (permisos específicos de esta máquina).
.claude/settings.local.json
.claude.local.md

# Configuración y credenciales locales; conservar la plantilla pública.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Python, entornos y resultados de pruebas.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/
*.egg-info/

# Capturas y diagnósticos: pueden incluir cookies, PSK o datos de clientes.
*.log
*.har
*.pcap
*.pcapng

# Archivos del sistema y temporales del editor.
.DS_Store
._*
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig

