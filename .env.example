# Safe defaults: local monitoring only. Replace placeholders before enabling integrations.
# Example: UNIFI_INFORM_URL=http://<UNIFI_HOST>:8080/inform
UNIFI_INFORM_URL=
# Use exact Huawei SSIDs and existing 24-character WLAN _id values from your UniFi site.
# Synthetic example only: {"ExampleSSID":"0123456789abcdef01234567"}
UNIFI_WLAN_MAP={}
# Leave empty to disable writes. To opt in, use the selected CPE's real management IP.
HUAWEI_CONTROL_IP=
